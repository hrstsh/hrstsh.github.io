---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleFooterNav from '../../components/ArticleFooterNav.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { tipArticle, toIsoDate } from '../../utils/jsonLd';

const title = 'X の検索を保存する Chrome 拡張を作ってみた - hrの備忘録';
const description = 'X(Twitter) の公式検索保存が新規追加できなくなったため、検索クエリを保存・管理できる Chrome 拡張を作成した手記。ツイート右クリックで画像を開く機能も実装。';
const jsonLd = tipArticle(title.replace(/ - hrの備忘録$/, ''), description, '/tried/twitter-search-save', toIsoDate('2026.03'), 'tried');

const storageStructure = `savedSearches: [
  { id, query, createdAt },
  ...
]`;

const updateSaveButtonPosition = `function updateSaveButtonPosition() {
    const wrapper = document.getElementById(SAVE_BUTTON_ID);
    if (!wrapper) return;
    const primaryColumn = document.querySelector('[data-testid="primaryColumn"]');
    if (!primaryColumn) return;
    const rect = primaryColumn.getBoundingClientRect();
    wrapper.style.left = (rect.right + 12) + 'px';
    wrapper.style.top = (rect.top + 16) + 'px';
}
setInterval(() => {
    if (document.visibilityState === 'visible') updateSearchSaveUI();
}, 2000);`;

const deleteStopPropagation = `div.querySelector('.search-item-delete').addEventListener('click', (e) => {
    e.stopPropagation();  // 親のクリック（検索実行）を防ぐ
    deleteSearch(item.id);
});`;

const getImageUrls = `function getImageUrlsFromTweet(article) {
    const imgs = article.querySelectorAll('[data-testid="tweetPhoto"] img');
    const seen = new Set();
    const urls = [];
    imgs.forEach((img) => {
        const src = img.src || img.getAttribute('data-src');
        if (src && src.includes('pbs.twimg.com/media/') && !seen.has(src)) {
            seen.add(src);
            urls.push(toOrigUrl(src));  // name=orig で原寸
        }
    });
    return urls;
}`;

const contextMenuPrevent = `document.addEventListener('contextmenu', (e) => {
    const article = e.target.closest('article[data-testid="tweet"]');
    if (!article) return;
    const imageUrls = getImageUrlsFromTweet(article);
    const tweetLink = getTweetLink(article);
    if (imageUrls.length > 0 || tweetLink) {
        e.preventDefault();
        e.stopPropagation();
        showTweetContextMenu(e.clientX, e.clientY, imageUrls, tweetLink);
    }
}, true);`;

const currentTags = ['twitter', 'chrome-extension'];
---

<ArticleLayout title={title} description={description} jsonLd={jsonLd} currentTags={currentTags}>
    <header class="article-header">
      <a href="/tried/" class="back-link">← やってみた一覧</a>
      <h1>X の検索を保存する Chrome 拡張を作ってみた</h1>
      <p class="article-meta">X(Twitter) の検索クエリを保存・管理し、ツイート右クリックで画像をまとめて開ける Chrome 拡張</p>
      <p class="article-date">2026.03</p>
    </header>

    <article class="article-body">
      <p>
        X の公式「検索の保存」が新規追加・削除できなくなって、よく使う検索を自分で管理できなくなっていた。なので代わりになる Chrome 拡張を作ることにした。ついでにツイートの画像をまとめて別タブで開きたい場面も多かったので、右クリックで「画像をすべて開く」「ツイートのリンクをコピー」ができる機能も足した。
      </p>

      <h2>よく使う検索を保存しておく</h2>
      <p>
        保存データは <code>chrome.storage.local</code> にこんな形で持ってる。
      </p>
      <CodeBlock code={storageStructure} language="text" />

      <p>
        ポップアップにはテキスト入力と追加ボタン・保存済みの一覧を置いた。検索ページにいるときはワンクリックで保存できるようにしたくて、UI の配置をどうするか考えた。検索入力欄の近くにボタンを差し込む案は、X の DOM 構造に強く依存するので UI 変更で壊れやすいと思ってやめた。採用したのは <code>[data-testid="primaryColumn"]</code> の右端に動的に配置するフローティングボタン。<code>getBoundingClientRect</code> で primaryColumn の位置を取って、fixed でボタンを置いている。X は SPA で、検索ページに遷移しても content script が再実行されない。なので 2 秒ごとに URL をチェックしてボタンの表示・位置を更新している。
      </p>
      <CodeBlock code={updateSaveButtonPosition} language="javascript" />

      <p>
        削除ボタンのクリックで <code>stopPropagation</code> を入れ忘れると、親要素のクリック（検索を開く）まで発火しちゃう。ドラッグ並び替えはハンドル（⋮⋮）を分けることで、「クリックで検索を開く」と「ドラッグで並び替え」を明確に区別できるようにしている。
      </p>
      <CodeBlock code={deleteStopPropagation} language="javascript" />

      <h2>ツイートの右クリックメニューは自前で出す</h2>
      <p>
        ツイートの右クリックで画像をまとめて開く機能では、Chrome 標準の <code>contextMenus</code> API も考えた。でもメニューを出す時点では「どのツイートか」が background に渡せなくて、画像 0 枚のツイートでメニューを隠すような動的な制御が難しそうだった。それでカスタムコンテキストメニューにした。content script で <code>contextmenu</code> を <code>preventDefault</code> し、右クリック時に同期的にツイートを特定して画像 URL を取得する。画像が 1 枚以上あるときだけ自前の div メニューを出す形。
      </p>

      <p>
        画像 URL は <code>[data-testid="tweetPhoto"] img</code> から取って、<code>pbs.twimg.com/media/</code> を含むものだけを対象にしている。<code>/profile_images/</code> のプロフィールアイコンは除外。原寸で表示したいので URL に <code>name=orig</code> を付けてる。
      </p>
      <CodeBlock code={getImageUrls} language="javascript" />

      <p>
        右クリックされたら <code>e.target.closest('article[data-testid="tweet"]')</code> でツイートを特定して、画像・リンクがあれば <code>preventDefault</code> してカスタムメニューを出す。
      </p>
      <CodeBlock code={contextMenuPrevent} language="javascript" />

      <p>
        実装した機能は 3 つ。検索の保存（ポップアップ・検索ページのワンクリック）、保存検索の管理（一覧・ドラッグ並び替え・削除・クリックで検索を開く）、ツイート右クリック（画像をすべて開く・リンクをコピー）。
      </p>

      <h2>作ってみて詰まったところ</h2>
      <p>
        いちばん手こずったのは、X が SPA で画面遷移しても content script が読み込み直されない点。検索ページに入った瞬間に保存ボタンを出したいのに最初の1回しか実行されないので、位置がずれたりボタンが消えたりする。最終的には一定間隔で URL と表示位置を見直す形に落ち着いた。でも本当はもっと素直に遷移を検知したいところ。
      </p>
      <p>
        もうひとつは <code>data-testid</code> への依存。<code>primaryColumn</code> や <code>tweetPhoto</code> みたいな目印は X 側の更新で変わることがあって、変わると配置も画像取得も一斉に効かなくなる。壊れたときにどこを直せばいいかわかるように、目印にしている属性名は一か所にまとめておくとあとが楽だった。
      </p>

      <h2>使うときの注意</h2>
      <p>
        右クリックでまとめて開いた画像は、自分で見るための取得にとどめておくのが無難。投稿された画像には作成者の権利があるので、保存するにしても再配布や無断転載にならないよう私的な利用の範囲で。
      </p>
    </article>

    <ArticleFooterNav currentHref="/tried/twitter-search-save/" currentTags={currentTags} backHref="/tried/" backLabel="← やってみた一覧に戻る" />
</ArticleLayout>

