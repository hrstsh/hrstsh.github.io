---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleFooterNav from '../../components/ArticleFooterNav.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { tipArticle, toIsoDate } from '../../utils/jsonLd';

const title = 'YouTubeのコメントからタイムスタンプを抽出するChrome拡張機能を作ってみた - hrの備忘録';
const description =
  'YouTube動画のコメント欄に埋もれたタイムスタンプを一覧表示し、クリックでその時刻にジャンプできるChrome拡張機能を作った記録。SPA遷移の検知、コメント欄の遅延読み込みへの追従、DOMに出ないチャプター情報の取得までの実装点をまとめた。';
const path = '/tried/youtube-timestamp-extension';
const jsonLd = tipArticle(title.replace(/ - hrの備忘録$/, ''), description, path, toIsoDate('2026.07'), 'tried');

const currentTags = ['youtube', 'chrome-extension'];

const navigateSnippet = `// YouTubeはSPAなので、content_scriptsはページ遷移のたびには再実行されない。
// YouTube自身が発火するこのイベントが、遷移検知として一番確実だった
function onNavigate() {
  if (location.pathname !== '/watch') {
    stopObserver();
    return;
  }
  startObserver();
  scheduleRender();
}

window.addEventListener('yt-navigate-finish', onNavigate);
onNavigate(); // 初回ロード分`;

const observerSnippet = `let debounceTimer = null;

function scheduleRender() {
  clearTimeout(debounceTimer);
  debounceTimer = setTimeout(render, 500);
}

function startObserver() {
  const target = document.querySelector('ytd-comments') || document.body;
  const observer = new MutationObserver(scheduleRender);
  observer.observe(target, { childList: true, subtree: true });
}`;

const buggyFix = `// 修正前：detail.response 直下にチャプターがある前提で読んでいた
window.addEventListener('yt-navigate-finish', (e) => {
  lastData = e?.detail?.response;
  post();
});

// 修正後：SPA遷移時は response.response、初回フルロード時は response 直下、
// どちらでもない場合は window.ytInitialData にフォールバック
window.addEventListener('yt-navigate-finish', (e) => {
  const r = e?.detail?.response;
  lastData = r?.response?.playerOverlays ? r.response
    : r?.playerOverlays ? r
    : window.ytInitialData;
  post();
});`;
---

<ArticleLayout title={title} description={description} jsonLd={jsonLd} currentTags={currentTags}>
    <header class="article-header">
      <a href="/tried/" class="back-link">← やってみた一覧</a>
      <h1>YouTubeのコメントからタイムスタンプを抽出するChrome拡張機能を作ってみた</h1>
      <p class="article-meta">動画を開くと自動でコメント欄のタイムスタンプを一覧表示するChrome拡張機能を作った</p>
      <p class="article-date">2026.07</p>
    </header>

    <article class="article-body">
      <p>
        以前作った<a href="/tips/youtube-timestamp-bookmarklet/">YouTubeのコメントからタイムスタンプを抽出するブックマークレット</a>が意外と重宝してる。ただ動画を開くたびに手動でクリックしないといけないし、あとから読み込んだコメントは一覧に反映されない。もっと当たり前に使いたかったので、Chrome拡張機能として作り直してみた。
      </p>

      <h2>つくったもの</h2>
      <p>
        動画ページを開くと、右上にパネルが自動で出てくる。動画に公式のチャプターが設定されていれば上段にその一覧、下にコメント欄から拾ったタイムスタンプが並ぶ形。どちらの行もクリックすると、その時刻に動画がジャンプする。
      </p>
      <figure class="article-image">
        <img src="/images/tried/youtube-timestamp-extension/panel.png" alt="YouTube動画ページの右上に自動表示されるタイムスタンプ抽出パネル。上段にチャプター一覧、下段にコメント由来のタイムスタンプ一覧が並ぶ" loading="lazy" />
        <figcaption>動画ページに自動表示されるパネル</figcaption>
      </figure>
      <p>
        コピーボタンで一覧をテキストとしてコピーもできる。×で閉じても、次の動画に移ればまた自動で表示される。今見てる動画だけ隠したいときは、ツールバーのアイコンから手動でオン・オフできるようにした。
      </p>

      <h2>タイムスタンプの抽出ロジックはほぼそのまま持ってきた</h2>
      <p>
        時刻を拾う正規表現・前後1秒以内の重複をまとめる処理・ラベルが空のときに次の行から補完する処理あたりは、<a href="/tips/youtube-timestamp-bookmarklet/">元のブックマークレット</a>のコードをほぼそのまま持ってきた。変わったのは実行のきっかけとデータの受け渡し方くらいで、コアのロジックには手を入れてない。
      </p>
      <p>
        これができたのは、抽出処理を最初から「コメント欄のDOMを受け取ってタイムスタンプの配列を返すだけの関数」として書いてたのが大きい。ブックマークレットではボタンを押した瞬間に1回呼んでいた関数を、拡張機能では <code>MutationObserver</code> のコールバックから何度も呼ぶように変えただけ。
      </p>

      <h2>動画を切り替えてもパネルが出るようにする</h2>
      <p>
        content scriptは、既定だとページ読み込み1回につき1回しか実行されない。でもYouTubeはSPAなので、動画を切り替えても実際にはページ全体をロードし直していない。素直に作ると「最初に開いた動画では動くけど、関連動画をクリックして遷移すると反応しなくなる」状態になってしまう。
      </p>
      <p>
        URLの変化を <code>setInterval</code> でポーリングして検知する手もある。ただ遅延が出るし、ずっとポーリングを回し続けるのはなんか気持ち悪い。なので、YouTube自身が遷移完了時に発火する <code>yt-navigate-finish</code> というイベントをそのままフックにした。
      </p>
      <CodeBlock code={navigateSnippet} language="javascript" />
      <p>
        <code>location.pathname !== '/watch'</code> のチェックを入れてるのは、検索結果やチャンネルページに移ったときにコメントの監視を止めるため。これがないと、動画ページを離れたあとも <code>MutationObserver</code> が関係ないページのDOM変化を拾い続けちゃう。
      </p>

      <h2>あとから読み込まれたコメントも拾いたい</h2>
      <p>
        コメント欄は最初から全件読み込まれてるわけじゃなく、スクロールに合わせて追加で取ってくる。一度抽出して終わりだと、あとから読み込まれた分のタイムスタンプが一覧に出てこない。<code>MutationObserver</code> でコメント欄のDOM変化を監視して、変化があったら再抽出する形にした。
      </p>
      <CodeBlock code={observerSnippet} language="javascript" />
      <p>
        監視対象は <code>document.querySelector('ytd-comments') || document.body</code> にしている。パネルを出した時点だと、コメント欄自体がまだDOMに入ってないことがあるので。一旦 <code>document.body</code> 全体を監視しておけば、あとからコメント欄が差し込まれた瞬間もそのまま拾える。
      </p>
      <p>
        コメントは連続して差し込まれることがあるので、変化のたびに再抽出してたら無駄が多い。500msのデバウンスを挟んで、DOMの変化が落ち着いたタイミングでまとめて再抽出するようにした。
      </p>

      <h2>チャプターはDOMじゃなく内部データに入ってた</h2>
      <p>
        コメントから拾ったタイムスタンプだけでなく、動画に公式で設定されているチャプターも一覧に出したくなった。でもチャプターのパネルは自分で開くまでDOMにレンダリングされないので、コメントと同じやり方（DOMを見て抽出）が使えない。
      </p>
      <p>
        調べてみると、チャプターの情報はページ内部の <code>ytInitialData</code> というJS変数に、動画を読み込んだ時点でもう入っていた。ただcontent scriptは既定だとページ本体とJSの実行環境が分かれていて、<code>window.ytInitialData</code> を直接読もうとしても <code>undefined</code> になる。<code>world: "MAIN"</code> のcontent scriptを追加して、<code>postMessage</code> で通常のcontent script側に受け渡す構成にして解決した。このあたりの仕組みは<a href="/tips/chrome-extension-window-object-access/">別のTipsにまとめた</a>。
      </p>
      <p>
        実装した直後は、チャプターが一覧にまったく出なかった。原因は <code>yt-navigate-finish</code> イベントの <code>detail.response</code> の構造が、ロードのタイミングによって違っていたこと。
      </p>
      <CodeBlock code={buggyFix} language="javascript" />
      <p>
        SPA遷移のときは <code>detail.response.response</code> の中にチャプターがあるのに、初回のフルロードのときは <code>detail.response</code> の直下に入っている。片方の形しか想定してなかったので、遷移のたびに抽出結果が空になっていた。ブックマークレットみたいにワンショットで終わる仕組みと違って、拡張機能はイベント経由でデータをやり取りする分、実機で構造を確かめながら潰していくしかなかった。
      </p>

      <h2>やってみて</h2>
      <p>
        抽出ロジックはほぼ流用できたので、ブックマークレットとの差分は実質「SPA遷移のフック」「MutationObserverによる追従」「MAIN worldとのメッセージング」の3点だけだった。逆にいうと、ブックマークレットで「開いたら自動で動く」ができないのはこの3点が原理的にないからで、拡張機能にする意味がどこにあるのかがはっきりした気がする。
      </p>
    </article>

    <ArticleFooterNav currentHref="/tried/youtube-timestamp-extension/" currentTags={currentTags} backHref="/tried/" backLabel="← やってみた一覧に戻る" />
</ArticleLayout>

<style>
  .article-header {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1rem;
    font-size: 0.9rem;
    color: var(--color-primary);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .article-meta {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .article-body h2 {
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.25rem;
  }

  .article-body p,
  .article-body ul,
  .article-body ol {
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .article-body ul,
  .article-body ol {
    padding-left: 2rem;
  }

  .article-body li {
    margin-bottom: 0.25rem;
  }

  .article-body a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .article-body a:hover {
    text-decoration: underline;
  }

  .article-body code {
    background: rgba(var(--accent-rgb), 0.08);
    color: var(--color-code);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .article-image {
    margin: 1.5rem auto;
    text-align: center;
    max-width: 560px;
  }

  .article-image img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--color-border, var(--color-codeblock-text));
  }

  .article-image figcaption {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 0.5rem;
  }
</style>
