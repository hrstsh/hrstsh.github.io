---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleFooterNav from '../../components/ArticleFooterNav.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { tipArticle, toIsoDate } from '../../utils/jsonLd';

const title = '動画のFPSと解像度をリアルタイム表示するChrome拡張機能を作ってみた - hrの備忘録';
const description = 'Webページで再生中の動画のFPSと解像度をリアルタイム表示するChrome拡張機能「Video FPS & Resolution Display」を作成した手記。導入方法と仕組みを解説。';
const jsonLd = tipArticle(title.replace(/ - hrの備忘録$/, ''), description, '/tried/video-fps-checker', toIsoDate('2026.02'), 'tried');

const manifestJson = `{
  "manifest_version": 3,
  "name": "Video FPS & Resolution Display",
  "version": "1.0.0",
  "description": "Webページで再生中の動画のFPSと解像度をリアルタイム表示します",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html"
}`;

const measureFPSRVFC = `function measureFPSWithRVFC(now, metadata) {
  const frames = metadata.presentedFrames;
  const elapsed = (now - tracker.windowStartTime) / 1000;
  if (elapsed >= 1) {
    const deltaFrames = frames - tracker.windowStartFrames;
    tracker.fps = deltaFrames / elapsed;
    tracker.windowStartTime = now;
    tracker.windowStartFrames = frames;
  }
  updateDisplay();
  tracker.callbackId = video.requestVideoFrameCallback(measureFPSWithRVFC);
}`;

const measureFPSRAF = `function measureFPSWithRAF() {
  const quality = video.getVideoPlaybackQuality?.();
  const now = performance.now();
  const frames = quality?.totalVideoFrames ?? 0;
  const elapsed = (now - tracker.windowStartTime) / 1000;
  if (elapsed >= 1 && frames >= tracker.windowStartFrames) {
    const deltaFrames = frames - tracker.windowStartFrames;
    tracker.fps = deltaFrames / elapsed;
    tracker.windowStartTime = now;
    tracker.windowStartFrames = frames;
  }
  updateDisplay();
  tracker.rafId = requestAnimationFrame(measureFPSWithRAF);
}`;

const startTracking = `if ('requestVideoFrameCallback' in HTMLVideoElement.prototype) {
  tracker.callbackId = video.requestVideoFrameCallback(measureFPSWithRVFC);
} else {
  tracker.rafId = requestAnimationFrame(measureFPSWithRAF);
}
const observer = new MutationObserver(() => scanForVideos());
observer.observe(document.body, { childList: true, subtree: true });`;

const currentTags = ['chrome-extension'];
---

<ArticleLayout title={title} description={description} jsonLd={jsonLd} currentTags={currentTags}>
    <header class="article-header">
      <a href="/tried/" class="back-link">← やってみた一覧</a>
      <h1>動画のFPSと解像度をリアルタイム表示するChrome拡張機能を作ってみた</h1>
      <p class="article-meta">YouTube・ニコニコ動画などで動画のFPSと解像度をオーバーレイ表示する拡張機能</p>
      <p class="article-date">2026.02</p>
    </header>

    <article class="article-body">
      <p>
        Webページで再生中の動画の FPS と解像度をリアルタイムで確認したくて、Chrome 拡張機能を作ってみた。対応しているのは YouTube・ニコニコ動画とその他の HTML5 動画。ソースコードは <a href="https://github.com/hrstsh/video-fps-checker" target="_blank" rel="noopener noreferrer">GitHub</a> で公開してる。
      </p>

      <p>
        manifest.json はこんな構成。
      </p>
      <CodeBlock code={manifestJson} language="json" />

      <p>
        動画を再生していると、画面の上にオーバーレイで FPS・解像度・ドロップフレーム数が出る。デフォルトは右上に緑色の文字。
      </p>
      <figure class="article-image">
        <img src="/images/tried/video-fps-checker/display.png" alt="YouTubeで動画再生中、右上にFPS・解像度・ドロップフレーム数が表示されている様子" />
        <figcaption>動画再生時の表示例（YouTube）</figcaption>
      </figure>

      <h2>使い方</h2>
      <p>
        インストールはリポジトリをクローンするか ZIP でダウンロードして、Chrome の <code>chrome://extensions/</code> で「デベロッパーモード」を ON にしてから「パッケージ化されていない拡張機能を読み込む」でフォルダを選ぶ。動画ページを開くと自動で表示されて、アイコンのクリックで ON/OFF を切り替えられる。「設定を開く」から表示位置（左上/右上/左下/右下）と文字色も変えられる。
      </p>

      <p>
        ポップアップと設定画面の例。表示位置は「左上」「右上」「左下」「右下」から選べて、文字色はカラーピッカーか HEX コードで指定できる。
      </p>
      <figure class="article-image">
        <img src="/images/tried/video-fps-checker/popup.png" alt="拡張機能のポップアップ。表示のトグルスイッチと「設定を開く」リンクがある" />
        <figcaption>アイコンクリックで表示されるポップアップ</figcaption>
      </figure>
      <figure class="article-image article-image--65">
        <img src="/images/tried/video-fps-checker/options.png" alt="設定画面。表示位置のセレクトボックスと文字色のカラーピッカー、プレビューが表示されている" />
        <figcaption>オプション画面（表示位置・文字色の設定）</figcaption>
      </figure>

      <h2>FPS は 1 秒ごとのフレーム数の差分で出す</h2>
      <p>
        FPS の計測には <code>requestVideoFrameCallback</code>（Chrome 83+ で使える）を優先して使っている。動画のフレームが描画されるたびにコールバックが呼ばれるので、<code>metadata.presentedFrames</code> から経過フレーム数を取る。1 秒窓で差分を取って FPS を出す。
      </p>
      <CodeBlock code={measureFPSRVFC} language="javascript" />

      <p>
        非対応の環境では <code>getVideoPlaybackQuality</code> の <code>totalVideoFrames</code> を <code>requestAnimationFrame</code> でサンプリングして、同じように 1 秒窓の差分から FPS を出すフォールバックにしてる。
      </p>
      <CodeBlock code={measureFPSRAF} language="javascript" />

      <p>
        どっちを使うかは起動時に API があるかどうかで決めて、<code>play</code> / <code>pause</code> / <code>ended</code> で計測の開始・停止を制御している。解像度は <code>videoWidth</code> / <code>videoHeight</code> から。ドロップフレームは <code>droppedVideoFrames</code> の 1 秒間の増分を表示。MutationObserver で <code>document.body</code> を監視して、動的に追加される動画（SPA のページ遷移など）も拾えるようにしている。
      </p>
      <CodeBlock code={startTracking} language="javascript" />

      <p>
        注意点もいくつか。動画が一時停止している間は FPS の計測も止めて「停止」と表示する。サイトによっては動画の実装の都合で正しく計測できないこともある。動作は Chrome（Chromium 系）を想定してる。
      </p>

      <h2>2つの計測方法は精度が違う</h2>
      <p>
        <code>requestVideoFrameCallback</code> は動画の新しいフレームが実際に画面に出たタイミングで呼ばれる。表示されたフレーム数をそのまま数えられるので、計測がフレームの描画そのものに連動して実際の再生フレームレートに近い値が出る。<code>requestAnimationFrame</code> のほうはディスプレイの再描画に合わせて呼ばれるだけで、動画のフレームとは独立してる。なので <code>getVideoPlaybackQuality</code> の累計フレーム数を一定間隔でサンプリングして、差分から求める近似値になる。新しい API が使えるならそっちを優先して、使えない環境でも数値が出るように後者に切り替えている。
      </p>

      <h2>こんなときに使える</h2>
      <p>
        配信や録画の設定どおりにフレームレートが出ているか確かめたいときとか、再生がカクつく原因がドロップフレームなのかを切り分けたいときに使える。解像度も一緒に出るので、自動画質で実際にどの解像度が選ばれているかもパッとわかる。
      </p>
    </article>

    <ArticleFooterNav currentHref="/tried/video-fps-checker/" currentTags={currentTags} backHref="/tried/" backLabel="← やってみた一覧に戻る" />
</ArticleLayout>

