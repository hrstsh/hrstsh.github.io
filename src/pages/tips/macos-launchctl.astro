const keepAliveExample = `<!-- プロセスが落ちたら自動で再起動する（常駐用） -->
<key>KeepAlive</key>
<true/>

<!-- 条件つきの再起動（異常終了したときだけ再起動する） -->
<key>KeepAlive</key>
<dict>
    <key>SuccessfulExit</key>
    <false/>
