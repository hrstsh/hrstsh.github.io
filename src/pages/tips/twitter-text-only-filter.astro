---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleFooterNav from '../../components/ArticleFooterNav.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { tipArticle, toIsoDate } from '../../utils/jsonLd';

const title = 'X(Twitter)で画像を非表示にする方法（タイムラインをテキストだけにする） - hrの備忘録';
const description = 'X(Twitter) のタイムラインで画像・動画付きのツイートを非表示にし、テキストだけを表示する方法。X の設定に該当する項目はないので、ブックマークレットか Chrome 拡張で消す。コードはコピーしてそのまま使える。';
const jsonLd = tipArticle(title.replace(/ - hrの備忘録$/, ''), description, '/tips/twitter-text-only-filter', toIsoDate('2026.02'), 'tips');

const bookmarkletCode = `javascript:(function(){const id='twitter-text-only';let s=document.getElementById(id);if(s){s.remove();}else{s=document.createElement('style');s.id=id;s.textContent='div[data-testid="cellInnerDiv"]:has(article):has(div[data-testid="tweetPhoto"]),div[data-testid="cellInnerDiv"]:has(article):has(video){display:none!important;}';document.head.appendChild(s);}})();`;

const manifestCode = `{
  "manifest_version": 3,
  "name": "Twitter Text Only Filter",
  "version": "1.0",
  "description": "X(Twitter)で画像・動画付きツイートを非表示にしてテキストのみ表示",
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}`;

const contentJsCode = `chrome.storage.sync.get(['enabled'], function(result) {
  if (result.enabled) applyFilter();
});

chrome.storage.onChanged.addListener(function(changes) {
  if (changes.enabled) {
    changes.enabled.newValue ? applyFilter() : removeFilter();
  }
});

function applyFilter() {
  const existing = document.getElementById('twitter-text-only-filter');
  if (existing) existing.remove();

  const style = document.createElement('style');
  style.id = 'twitter-text-only-filter';
  style.textContent = \`
    div[data-testid="cellInnerDiv"]:has(article):has(div[data-testid="tweetPhoto"]),
    div[data-testid="cellInnerDiv"]:has(article):has(video) {
      display: none !important;
    }
  \`;
  document.head.appendChild(style);
}

function removeFilter() {
  const style = document.getElementById('twitter-text-only-filter');
  if (style) style.remove();
}`;

const popupHtmlCode = `<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { width: 200px; padding: 15px; font-family: sans-serif; }
    label { display: flex; align-items: center; cursor: pointer; }
    input[type="checkbox"] { margin-right: 8px; }
  </style>
</head>
<body>
  <label>
    <input type="checkbox" id="toggle">
    テキストのみ表示
  </label>
  <script src="${'popup' + '.js'}"></script>
</body>
</html>`;

const popupJsCode = `const toggle = document.getElementById('toggle');
chrome.storage.sync.get(['enabled'], function(result) {
  toggle.checked = result.enabled || false;
});
toggle.addEventListener('change', function() {
  chrome.storage.sync.set({ enabled: toggle.checked });
});`;
const currentTags = ['twitter', 'bookmarklet', 'chrome-extension'];
---

<ArticleLayout title={title} description={description} jsonLd={jsonLd} currentTags={currentTags}>
    <header class="article-header">
      <a href="/tips/" class="back-link">← Tips一覧</a>
      <h1>X(Twitter)で画像を非表示にする方法（タイムラインをテキストだけにする）</h1>
      <p class="article-date">2026.02</p>
    </header>

    <article class="article-body">
      <p>
        X でテキスト主体のタイムラインを読みたいとき、画像や動画付きのツイートが続くと流れが途切れて読みづらい。画像のみ表示とは逆に、画像・動画付きのツイートを隠してテキストだけ残すやり方をまとめた。ブックマークレットですぐ試す方法と、ページを開くたびに自動で効く Chrome 拡張の2通りを用意してる。
      </p>

      <h2>何ができるか</h2>
      <ul>
        <li>画像・動画が含まれるツイートを自動で非表示</li>
        <li>テキストだけのツイートが残る</li>
        <li>読み物としてのタイムラインに集中できる</li>
        <li>ON/OFF はワンクリックで切り替え（拡張機能版）</li>
      </ul>

      <h2>方法1: ブックマークレット版</h2>
      <p>
        インストールなしで、ブックマークレットを1つ作れば済む。
      </p>
      <ol>
        <li>Chrome で新しいブックマークを作成（ブックマークバーを右クリック → 「ページを追加」）</li>
        <li>名前を「Twitter テキストのみ」などに設定</li>
        <li>URL に次のコードを貼り付ける</li>
      </ol>

      <CodeBlock code={bookmarkletCode} language="javascript" />

      <h3>使い方</h3>
      <ol>
        <li>X(Twitter) のタイムラインを開く</li>
        <li>作ったブックマークレットをクリック</li>
        <li>画像・動画付きツイートが非表示になる</li>
        <li>もう一度クリックすると解除される（トグル動作）</li>
      </ol>

      <h2>方法2: Chrome 拡張機能版</h2>
      <p>
        X を開くと毎回フィルターがかかるようにする拡張機能。
      </p>

      <h3>1. フォルダ構成</h3>
      <pre><code class="language-text">twitter-text-only-filter/
├── manifest.json
├── content.js
├── popup.html
└── popup.js</code></pre>

      <h3>2. manifest.json</h3>
      <CodeBlock code={manifestCode} language="json" />

      <h3>3. content.js</h3>
      <CodeBlock code={contentJsCode} language="javascript" />

      <h3>4. popup.html</h3>
      <CodeBlock code={popupHtmlCode} language="html" />

      <h3>5. popup.js</h3>
      <CodeBlock code={popupJsCode} language="javascript" />

      <h3>6. 拡張機能のインストール</h3>
      <ol>
        <li>Chrome で <code>chrome://extensions/</code> を開く</li>
        <li>右上の「デベロッパーモード」をオン</li>
        <li>「パッケージ化されていない拡張機能を読み込む」をクリック</li>
        <li>作ったフォルダを選択</li>
      </ol>

      <h2>画像付きツイートの見分け方</h2>
      <p>
        CSS の <code>:has()</code> 擬似クラスで、画像・動画を含むツイートを見つけて非表示にしている。
      </p>
      <ul>
        <li><code>div[data-testid="tweetPhoto"]</code> を持つセル → 画像付きツイート</li>
        <li><code>video</code> 要素を持つセル → 動画付きツイート</li>
      </ul>
      <p>
        ポイントは、<code>:has()</code> で「中に画像や動画を含むセル」を親の側から指定しているところ。昔の CSS だと子要素があるかどうかで親を選べなかったので、こういう絞り込みには JavaScript が要った。<code>:has()</code> が使えるようになって、要素をひとつ差し込むだけの短い CSS で済むようになった。ツイート1件は <code>div[data-testid="cellInnerDiv"]</code> という箱に入っていて、その中に <code>tweetPhoto</code> か <code>video</code> があれば箱ごと <code>display: none</code> で隠している。
      </p>
      <p>
        投稿を消すのではなく見えなくしているだけなので、解除すればすぐ元に戻る。スクロールしてあとから増えたツイートにも、CSS のルールが残っている間はそのまま効く。JavaScript で1件ずつ見ていくやり方と違って、新しく出てきた要素を見張り続けなくていいのが CSS で書くうれしいところ。
      </p>

      <h2>ブックマークレットと拡張機能の使い分け</h2>
      <p>
        ときどき切り替えたいだけならブックマークレットで足りる。クリックしたらその場で効いて、もう一度押せば戻る。ただページをリロードすると解除される。いつもテキストだけで読みたいなら拡張機能版がいい。content script がページを開くたびに保存してある設定を読みにいくので、毎回ブックマークを押さなくて済む。まずブックマークレットで動きを試して、気に入ったら拡張機能に移る順番だと無駄がない。
      </p>

      <h2>関連</h2>
      <p>
        逆の動き（<a href="/tips/twitter-image-only-filter/">画像・動画のみ表示</a>）も同じやり方でできる。
      </p>

      <h2>よくある質問</h2>

      <h3>X の設定で画像を非表示にできる？</h3>
      <p>
        ブラウザ版の設定をひととおり見たかぎり、タイムラインの画像をまとめて隠す項目はない。データ利用の設定にあるのは画質や動画の自動再生の切り替えで、画像そのものを消すものじゃない。X 側ではどうにもならないので、表示するブラウザの側で消すことになる。
      </p>

      <h3>画像だけ非表示にして、動画は残したい</h3>
      <p>
        セレクタから動画用の行を外せばいい。<code>video</code> を含む条件を削って <code>div[data-testid="cellInnerDiv"]:has(article):has(div[data-testid="tweetPhoto"])</code> だけにすると、画像付きツイートだけが消えて動画はそのまま流れる。逆に動画だけ消したいなら <code>tweetPhoto</code> の行を外す。
      </p>

      <h3>スマホ（iPhone / Android アプリ）でも画像を非表示にできる？</h3>
      <p>
        ここで紹介したのはデスクトップの Chrome 向けなので、スマホの X アプリには効かない。iPhone なら Safari にブックマークレットを登録すれば Web 版のタイムラインで動かせる余地はある。ただアプリで見てる人が多いぶん、あまり期待しないほうがいい。PC で読むときの対策と割り切るのが現実的。
      </p>

      <h3>ミュートやブロックとは何が違う？</h3>
      <p>
        ミュートやブロックは相手ごとに投稿を見えなくする機能で、X 側に状態が残る。こっちは自分のブラウザの表示を変えるだけなので、特定の相手ではなく「画像・動画付き」という条件でまとめて隠せる。相手の投稿そのものや通知には手を付けない。
      </p>

      <h2>つまずきやすいところ・注意</h2>
      <ul>
        <li>X 側の DOM はいつの間にか変わっていることがある。急に効かなくなったら <code>tweetPhoto</code> や <code>cellInnerDiv</code> みたいなセレクタが今も合ってるか見て直す。</li>
        <li>ブックマークレット版はページをリロードすると解除される。ずっと効かせたいなら拡張機能版を使う。</li>
        <li><code>:has()</code> は割と新しめの CSS なので、古いブラウザだと効かないことがある。最近の Chrome なら問題ない。</li>
        <li>手元のタイムラインの見え方を変えるだけで、相手の投稿や通知には影響しない。</li>
      </ul>

    </article>

    <ArticleFooterNav currentHref="/tips/twitter-text-only-filter/" currentTags={currentTags} backHref="/tips/" backLabel="← Tips一覧に戻る" />
</ArticleLayout>

