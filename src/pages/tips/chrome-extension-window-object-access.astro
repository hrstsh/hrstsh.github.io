---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleFooterNav from '../../components/ArticleFooterNav.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { tipArticle, toIsoDate, faqPage } from '../../utils/jsonLd';

const currentTags = ['chrome-extension', 'dev'];

const title = 'Chrome拡張機能でページ内部のJS変数（windowオブジェクト）を取得する方法 - hrの備忘録';
const description =
  'content scriptは既定でページのJSと隔離されており、window上の変数に直接アクセスできない。world: "MAIN" のcontent scriptとpostMessageを組み合わせて、DOMに出ていないページ内部のデータを安全に取得する方法をまとめた。';
const path = '/tips/chrome-extension-window-object-access';
const faqItems = [
  {
    question: 'isolated world と MAIN world の違いは？',
    answer:
      'isolated worldは普通のcontent scriptが動く環境で、ページのDOMは共有するがJSの実行環境（グローバル変数・関数）はページ側と分かれている。MAIN worldはページ自身のJSと同じ実行環境で、ページが定義したwindow上の変数に直接アクセスできる。',
  },
  {
    question: 'MAIN worldのスクリプトから chrome.storage は使える？',
    answer:
      '使えない。MAIN worldはページと同じ実行環境になる代わりに、ほとんどのchrome.* APIが使えなくなる。データはpostMessageなどでisolated world側のcontent scriptに渡して、chrome.* APIはisolated world側で呼ぶ。',
  },
  {
    question: 'postMessageを使うときのセキュリティ上の注意点は？',
    answer:
      '送信先は targetOrigin に location.origin を指定して、任意のオリジンには送らない。受信側では event.source が window自身であることと event.data.type が想定した値であることを確かめてから処理する。ほかのスクリプトやiframeからの偽装メッセージを拾わないようにするため。',
  },
  {
    question: 'この仕組みはYouTube以外のサイトでも使える？',
    answer:
      '使える。SPA（Single Page Application）で、実際のデータがDOMに描画される前からページ内部のJS変数に入っているサイトなら同じやり方でいける。変数名や構造はサイトごとに違うので、DevToolsのConsoleで window を調べて探すことになる。',
  },
];
const jsonLd = [
  tipArticle(title.replace(/ - hrの備忘録$/, ''), description, path, toIsoDate('2026.07'), 'tips'),
  faqPage(faqItems, path),
];

const manifestSnippet = `{
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["injected.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}`;

const mainWorldSnippet = `// injected.js（world: "MAIN" で実行される）
// ページと同じ実行環境なので window.ytInitialData に直接触れる
(() => {
  function post() {
    window.postMessage(
      { type: 'my-ext-data', payload: window.ytInitialData },
      location.origin
    );
  }
  post();
})();`;

const isolatedWorldSnippet = `// content.js（isolated world = 通常のcontent script）
window.addEventListener('message', (e) => {
  // 自分自身のwindowから、想定した type のメッセージだけ受け取る
  if (e.source !== window || !e.data || e.data.type !== 'my-ext-data') return;
  console.log(e.data.payload); // ここで初めて chrome.* API も使える
});`;

const requestResponseSnippet = `// injected.js 側：isolated world からの再送要求にも応える
window.addEventListener('message', (e) => {
  if (e.source === window && e.data?.type === 'my-ext-request') post();
});
post(); // 初回分

// content.js 側：起動したらまず再送を要求する
window.postMessage({ type: 'my-ext-request' }, location.origin);`;
---

<ArticleLayout title={title} description={description} jsonLd={jsonLd} currentTags={currentTags}>
    <header class="article-header">
      <a href="/tips/" class="back-link">&larr; Tips一覧</a>
      <h1>Chrome拡張機能でページ内部のJS変数（windowオブジェクト）を取得する方法</h1>
      <p class="article-date">2026.07</p>
    </header>

    <article class="article-body">
      <p>
        Chrome拡張機能でページの情報を取りたいときは、たいていDOMを見れば足りる。ただSPAのサイトだと、実際のデータがDOMじゃなくページ内部のJS変数（<code>window.xxx</code>）にしかないことがある。YouTubeの <code>window.ytInitialData</code> がまさにそれで、content scriptから直接読もうとしても <code>undefined</code> が返ってくる。その原因と取り出し方をまとめておく。
      </p>

      <nav class="toc" aria-label="目次">
        <p class="toc-title">目次</p>
        <ol>
          <li><a href="#isolated">content scriptはページと隔離されている</a></li>
          <li><a href="#main-world">MAIN worldでcontent scriptを動かす</a></li>
          <li><a href="#chrome-api">MAIN worldだとchrome.*が使えない</a></li>
          <li><a href="#timing">1回送るだけだと取りこぼす</a></li>
          <li><a href="#faq">よくある質問</a></li>
        </ol>
      </nav>

      <h2 id="isolated">content scriptはページと隔離されている</h2>
      <p>
        content scriptはページと同じDOMを触れる。でもJSの実行環境（world）はページ本体とは別になっている。これが「isolated world」と呼ばれる仕組みで、セキュリティのためにわざと分けてある。拡張機能はページのグローバル変数を汚さないし、逆にページ側のスクリプトも拡張機能の中の処理を覗けない。
      </p>
      <p>
        なのでページが <code>&lt;script&gt;</code> タグの中で <code>window.ytInitialData = &#123;...&#125;</code> みたいに変数を定義していても、content scriptから <code>window.ytInitialData</code> を読むと <code>undefined</code> になる。同じ <code>window</code> という名前でも、content script側から見えてるのは拡張機能専用の別の実行環境の <code>window</code>。
      </p>

      <h2 id="main-world">MAIN worldでcontent scriptを動かす</h2>
      <p>
        Manifest V3 なら、content scriptを <code>world: "MAIN"</code> 指定でページ本体と同じ実行環境に注入できる。<code>manifest.json</code> の <code>content_scripts</code> に、いつものisolated world用とMAIN world用の2つのエントリを並べて書く。
      </p>
      <CodeBlock code={manifestSnippet} language="json" />
      <p>
        MAIN world側のスクリプト（<code>injected.js</code>）は、ページ自身が書いたスクリプトと同じ扱いになる。なので <code>window.ytInitialData</code> に普通にアクセスできる。
      </p>

      <h2 id="chrome-api">MAIN worldだとchrome.*が使えない</h2>
      <p>
        気をつけたいのは、MAIN worldだとページと同じ実行環境になる代わりに <code>chrome.runtime</code> や <code>chrome.storage</code> みたいな拡張機能のAPIがほぼ使えなくなること。せっかく取れたデータも、そのままだと拡張機能側の処理（保存する・ほかのUIに渡すなど）につなげられない。
      </p>
      <p>
        そこでMAIN worldからisolated worldにデータを渡すのに <code>window.postMessage</code> を使う。どちらも同じページの <code>window</code> を通るので、DOMでイベントをやり取りするのと同じ感覚で使える。
      </p>
      <CodeBlock code={mainWorldSnippet} language="javascript" />
      <CodeBlock code={isolatedWorldSnippet} language="javascript" />
      <p>
        受信側で <code>e.source !== window</code> と <code>e.data.type</code> をチェックしてるのは、ほかのiframeやページ内の別のスクリプトが送ってくる関係ない message イベントを拾わないため。<code>postMessage</code> の送信先も <code>'*'</code> ではなく <code>location.origin</code> にして、想定外のオリジンには送らないようにしている。
      </p>

      <h2 id="timing">1回送るだけだと取りこぼす</h2>
      <p>
        実際に組んでみるとハマりやすいのが読み込み順。MAIN world側のスクリプトが先に実行されてデータを1回だけpostMessageしても、isolated world側のリスナーの登録がそれよりあとになると取りこぼす。SPAのページ遷移やスクリプトの実行順は保証されないので、「1回送って終わり」の作りは事故りやすい。
      </p>
      <p>
        対処は単純で、isolated world側が起動したタイミングで「もう1回送って」とリクエストを投げて、MAIN world側はそれを受けて改めてpostMessageする形にする。
      </p>
      <CodeBlock code={requestResponseSnippet} language="javascript" />
      <p>
        これでisolated world側のリスナー登録が多少遅れても、こっちから再送を頼めば必ず最新のデータを受け取れる。YouTubeみたいにSPA遷移でページ内のデータが更新されるサイトなら、遷移イベントのたびに同じ流れでpostMessageし直す作りにしておくと安定する。
      </p>

      <h2>関連記事</h2>
      <ul>
        <li><a href="/tried/youtube-timestamp-extension/">YouTubeのコメントからタイムスタンプを抽出するChrome拡張機能を作ってみた</a>（この仕組みを使ってYouTubeのチャプター情報を取得した実例）</li>
        <li><a href="/tips/youtube-timestamp-bookmarklet/">YouTubeのコメントからタイムスタンプを抽出するブックマークレット</a></li>
      </ul>

      <h2 id="faq">よくある質問</h2>
      <dl class="faq-list">
        <dt>isolated world と MAIN world の違いは？</dt>
        <dd>isolated worldは普通のcontent scriptが動く環境で、ページのDOMは共有するがJSの実行環境（グローバル変数・関数）はページ側と分かれている。MAIN worldはページ自身のJSと同じ実行環境で、ページが定義したwindow上の変数に直接アクセスできる。</dd>
        <dt>MAIN worldのスクリプトから chrome.storage は使える？</dt>
        <dd>使えない。MAIN worldはページと同じ実行環境になる代わりに、ほとんどのchrome.* APIが使えなくなる。データはpostMessageなどでisolated world側のcontent scriptに渡して、chrome.* APIはisolated world側で呼ぶ。</dd>
        <dt>postMessageを使うときのセキュリティ上の注意点は？</dt>
        <dd>送信先は targetOrigin に location.origin を指定して、任意のオリジンには送らない。受信側では event.source が window自身であることと event.data.type が想定した値であることを確かめてから処理する。ほかのスクリプトやiframeからの偽装メッセージを拾わないようにするため。</dd>
        <dt>この仕組みはYouTube以外のサイトでも使える？</dt>
        <dd>使える。SPA（Single Page Application）で、実際のデータがDOMに描画される前からページ内部のJS変数に入っているサイトなら同じやり方でいける。変数名や構造はサイトごとに違うので、DevToolsのConsoleで window を調べて探すことになる。</dd>
      </dl>
    </article>

    <ArticleFooterNav currentHref="/tips/chrome-extension-window-object-access/" currentTags={currentTags} backHref="/tips/" backLabel="← Tips一覧に戻る" />
</ArticleLayout>

