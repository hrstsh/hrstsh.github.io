---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleFooterNav from '../../components/ArticleFooterNav.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { tipArticle, toIsoDate } from '../../utils/jsonLd';

const title = 'X(Twitter)の画像を一括保存する方法（メディア欄からまとめてダウンロード） - hrの備忘録';
const description = 'X(Twitter) のメディア欄に表示される画像を、オリジナル画質でまとめて保存する方法。ブックマークレットでワンクリック取得、wget や Python での一括ダウンロード手順まで解説。';
const jsonLd = tipArticle(title.replace(/ - hrの備忘録$/, ''), description, '/tips/twitter-media-url-extractor', toIsoDate('2026.02'), 'tips');

const basicScript = `// 現在表示されている画像URLを取得
const urls = Array.from(document.querySelectorAll('img[src*="pbs.twimg.com"]'))
  .map(img => img.src.replace(/&name=\\w+/, '&name=orig'))
  .filter(url => url.includes('/media/'))
  .filter((v, i, a) => a.indexOf(v) === i);

console.log(urls.join('\\n'));
console.log(\`取得件数: \${urls.length}件\`);`;

const selectAllScript = `// コンソールでURLを全選択しやすく出力
const urls = Array.from(document.querySelectorAll('img[src*="pbs.twimg.com"]'))
  .map(img => img.src.replace(/&name=\\w+/, '&name=orig'))
  .filter(url => url.includes('/media/'))
  .filter((v, i, a) => a.indexOf(v) === i);

// 区切り線で見やすく出力
console.log('========== 画像URL一覧 ==========');
console.log(urls.join('\\n'));
console.log('==================================');
console.log(\`取得件数: \${urls.length}件\`);
console.log('上記のURLをコピーしてください');`;

const bookmarkletCode = `javascript:(function(){const u=Array.from(document.querySelectorAll('img[src*="pbs.twimg.com"]')).map(i=>i.src.replace(/&name=\\w+/,'&name=orig')).filter(url=>url.includes('/media/')).filter((v,i,a)=>a.indexOf(v)===i);navigator.clipboard.writeText(u.join('\\n')).then(()=>alert(u.length+'件の画像URLをコピーしました！'));})();`;

const pythonScript = `import requests
import os
from urllib.parse import urlparse, parse_qs

# urls.txt から URL を読み込んでダウンロード
def download_images(url_file='urls.txt', output_dir='twitter_images'):
    # 出力ディレクトリを作成
    os.makedirs(output_dir, exist_ok=True)
    
    # URLs を読み込み
    with open(url_file, 'r') as f:
        urls = [line.strip() for line in f if line.strip()]
    
    print(f'{len(urls)}件の画像をダウンロード開始...')
    
    # 各URLをダウンロード
    for i, url in enumerate(urls, 1):
        try:
            response = requests.get(url, timeout=30)
            response.raise_for_status()
            
            # ファイル名を生成（拡張子は URL の format= に合わせる）
            ext = parse_qs(urlparse(url).query).get('format', ['jpg'])[0]
            filename = f'twitter_image_{i:03d}.{ext}'
            filepath = os.path.join(output_dir, filename)
            
            # 保存
            with open(filepath, 'wb') as f:
                f.write(response.content)
            
            print(f'[{i}/{len(urls)}] {filename} ダウンロード完了')
            
        except Exception as e:
            print(f'[{i}/{len(urls)}] エラー: {e}')
    
    print(f'\\n完了！{output_dir}/ に保存されました')

if __name__ == '__main__':
    download_images()`;

const autoScrollScript = `// 自動スクロールして全画像を読み込む
async function loadAllMedia() {
  let lastHeight = 0;
  let scrollCount = 0;
  const maxScrolls = 50; // 最大スクロール回数
  
  while (scrollCount < maxScrolls) {
    window.scrollTo(0, document.body.scrollHeight);
    await new Promise(resolve => setTimeout(resolve, 1000));
    
    const currentHeight = document.body.scrollHeight;
    if (currentHeight === lastHeight) {
      console.log('最後まで読み込みました');
      break;
    }
    lastHeight = currentHeight;
    scrollCount++;
  }
  
  // URL取得
  const urls = Array.from(document.querySelectorAll('img[src*="pbs.twimg.com"]'))
    .map(img => img.src.replace(/&name=\\w+/, '&name=orig'))
    .filter(url => url.includes('/media/'))
    .filter((v, i, a) => a.indexOf(v) === i);
  
  console.log(\`取得件数: \${urls.length}件\`);
  console.log(urls.join('\\n'));
  
  return urls;
}

// 実行
loadAllMedia();`;

const openTabsScript = `// 新しいタブで画像を一括表示
async function openAllMedia() {
  // 1. URL取得
  const urls = Array.from(document.querySelectorAll('img[src*="pbs.twimg.com"]'))
    .map(img => img.src.replace(/&name=\\w+/, '&name=orig'))
    .filter(url => url.includes('/media/'))
    .filter((v, i, a) => a.indexOf(v) === i);
  
  console.log(\`\${urls.length}件の画像を新しいタブで開きます...\`);
  
  // 確認
  if (!confirm(\`\${urls.length}件の画像を新しいタブで開きますか？\`)) {
    return;
  }
  
  // 2. 順次タブで開く
  for (let i = 0; i < urls.length; i++) {
    window.open(urls[i], '_blank');
    console.log(\`[\${i + 1}/\${urls.length}] タブを開きました\`);
    
    // ブラウザの制限を避けるため少し待機
    await new Promise(resolve => setTimeout(resolve, 300));
  }
  
  console.log('完了！各タブで右クリック→「名前を付けて保存」でダウンロードしてください');
}

// 実行
openAllMedia();`;
const currentTags = ['twitter', 'bookmarklet'];
---

<ArticleLayout title={title} description={description} jsonLd={jsonLd} currentTags={currentTags}>
    <header class="article-header">
      <a href="/tips/" class="back-link">← Tips一覧</a>
      <h1>X(Twitter)の画像を一括保存する方法</h1>
      <p class="article-date">2026.02</p>
    </header>

    <article class="article-body">
      <p>
        X(Twitter) のメディアタブに並んでる画像をオリジナル画質でまとめて保存したいときのやり方。ブックマークレットで画像URLをワンクリックで取ってきて、wget か Python で一括ダウンロードする。URLはすべて <code>&name=orig</code> 付きなのでオリジナル画質のまま保存できる。
      </p>

      <h2>メディアタブとは</h2>
      <p>
        ユーザーのプロフィールページで「メディア」タブをクリックすると、そのユーザーが投稿した画像や動画が一覧で出てくる。
      </p>
      <p>
        URLで直接開くなら <code>https://x.com/username/media</code>。
      </p>

      <h2>基本：画像URLを取り出す</h2>
      
      <h3>1. メディアタブを開く</h3>
      <p>
        対象ユーザーのプロフィールページで「メディア」タブをクリック。
      </p>

      <h3>2. 開発者ツールを開く</h3>
      <p>
        どれかの方法で開く。
      </p>
      <ul>
        <li>Macの場合: <code>Command + Option + J</code></li>
        <li>Windowsの場合: <code>Ctrl + Shift + J</code></li>
        <li>または右クリック → <strong>検証</strong> → <strong>Console</strong>タブ</li>
      </ul>

      <h3>3. コンソールにスクリプトを貼る</h3>
      <p>
        次のスクリプトをコピーして、コンソールに貼り付けて Enter。
      </p>
      <CodeBlock code={basicScript} language="javascript" />
      <p>
        今表示されている画像のURLがコンソールに出てくる。<code>&name=orig</code> 付きなのでオリジナル画質で取れる。
      </p>

      <h3>4. 出てきたURLをコピー</h3>
      <p>
        コンソールに出たURLをマウスのドラッグで選択してコピーする（<code>Ctrl+C</code> / <code>Cmd+C</code>）。
      </p>
      
      <div class="note-box">
        <strong>💡 Tips: 見やすく出力する</strong>
        <p>
          区切り線を入れて見やすく出すバージョン。
        </p>
        <CodeBlock code={selectAllScript} language="javascript" />
        <p>
          これならURLの部分だけ選択しやすい。
        </p>
      </div>

      <h2>ブックマークレット版（おすすめ）</h2>
      <p>
        毎回コンソールを開くのが面倒なときは、ブックマークレットに登録しておけばワンクリックで実行できる。<strong>ブックマークレットならクリップボードへの自動コピーもできる。</strong>
      </p>

      <h3>登録方法</h3>
      <ol>
        <li>ブックマークバーを表示（<code>Ctrl+Shift+B</code> / <code>Cmd+Shift+B</code>）</li>
        <li>ブックマークバーの上で右クリック → 「ページを追加」</li>
        <li>名前: <code>X画像URL取得</code>（任意）</li>
        <li>URL: 次のコードをコピー</li>
      </ol>
      <CodeBlock code={bookmarkletCode} language="javascript" />
      <p>
        登録したら、メディアタブでブックマークレットをクリックするだけ。<strong>画像URLが自動でクリップボードにコピーされる。</strong>
      </p>
      
      <div class="note-box note-box-info">
        <strong>💡 ブックマークレットがおすすめな理由</strong>
        <ul>
          <li>ワンクリックで実行できる</li>
          <li>クリップボードに自動でコピーできる（コンソール版は手で選ぶか <code>copy()</code> を書き足す）</li>
          <li>開発者ツールを開かなくていい</li>
        </ul>
      </div>

      <h2>応用：自動スクロールで全部の画像を拾う</h2>
      <p>
        メディアタブは最初に一部の画像しか表示されないので、スクロールして追加で読み込まないといけない。自動でスクロールして全部の画像を読み込んでからURLを取るスクリプトがこれ。
      </p>
      <CodeBlock code={autoScrollScript} language="javascript" />
      <p>
        スクロールしながら画像を読み込んで、いちばん下まで着いたらURLを取り出す。画像が多いと時間がかかるので注意。
      </p>

      <h2>URLから画像をまとめてダウンロードする</h2>
      
      <div class="note-box">
        <strong>⚠️ リンクを作るだけでは保存できない</strong>
        <p>
          Twitter の画像は別ドメイン（pbs.twimg.com）に置かれている。別ドメインの URL だとリンクの <code>download</code> 属性が効かないので、クリックしても画像が開くだけ。
        </p>
        <p>
          JavaScript で <code>fetch</code> して Blob にすれば保存はできる（2026 年 10 月時点で pbs.twimg.com は CORS で読み込みを許可してる）。ただスクリプトが長くなるので、ここでは次のどれかの手軽な方法でやる。
        </p>
      </div>
      
      <h3>方法1: タブで一括表示 → 手動保存</h3>
      <p>
        画像をそれぞれ新しいタブで開いて、手動で保存するやり方。
      </p>
      <CodeBlock code={openTabsScript} language="javascript" />
      
      <div class="note-box">
        <strong>⚠️ 初めて実行したとき</strong>
        <p>
          最初に実行したときは、ブラウザのポップアップブロックが働いて1つ目のタブしか開かない。次の手順でポップアップを許可する。
        </p>
        <ol>
          <li>アドレスバーの右側に出るポップアップブロックのアイコンをクリック</li>
          <li>「x.com のポップアップとリダイレクトを常に許可する」を選択</li>
          <li>スクリプトを再実行</li>
        </ol>
        <p>
          許可したあとはすべての画像が新しいタブで開く。
        </p>
      </div>
      
      <p>
        あとは各タブで右クリック → 「名前を付けて画像を保存」でダウンロードする。
      </p>
      
      <div class="note-box note-box-info">
        <strong>💡 Tips</strong>
        <ul>
          <li>画像が多いとブラウザが重くなりやすい</li>
          <li>10〜20件ずつに分けて実行するのがおすすめ</li>
        </ul>
      </div>

      <h3>方法2: wget で一括ダウンロード</h3>
      <p>
        <code>wget</code> を使えばターミナルから一括でダウンロードできる。
      </p>
      <ol>
        <li>上のスクリプトでURLを取ってコピー</li>
        <li>テキストエディタで <code>urls.txt</code> に保存（1行1URL）</li>
        <li>ターミナルで次を実行</li>
      </ol>
      <CodeBlock code="wget -i urls.txt -P ./twitter_images" language="bash" />
      <p>
        <code>./twitter_images</code> フォルダに画像が全部ダウンロードされる。
      </p>
      
      <div class="note-box note-box-info">
        <strong>💡 wget が入っていないとき</strong>
        <ul>
          <li><strong>Mac</strong>: <code>brew install wget</code></li>
          <li><strong>Windows</strong>: Git Bash または WSL で <code>wget</code> が使える</li>
        </ul>
      </div>

      <h3>方法3: Python3 で一括ダウンロード（おすすめ）</h3>
      <p>
        Python3 で一括ダウンロードするスクリプト。
      </p>
      
      <h4>準備</h4>
      <CodeBlock code="pip3 install requests" language="bash" />
      
      <h4>スクリプト</h4>
      <p>
        <code>download_twitter_images.py</code> という名前で保存する。
      </p>
      <CodeBlock code={pythonScript} language="python" />
      
      <h4>実行</h4>
      <ol>
        <li>URLを取って <code>urls.txt</code> に保存（1行1URL）</li>
        <li>スクリプトと同じフォルダに <code>urls.txt</code> を置く</li>
        <li>ターミナルで実行</li>
      </ol>
      <CodeBlock code="python3 download_twitter_images.py" language="bash" />
      <p>
        <code>twitter_images/</code> フォルダに <code>twitter_image_001.jpg</code>、<code>twitter_image_002.jpg</code>... という連番で保存される。PNG の画像は URL の <code>format=png</code> に合わせて拡張子が <code>.png</code> になる。
      </p>
      
      <div class="note-box note-box-info">
        <strong>💡 Python を使うと楽なところ</strong>
        <ul>
          <li>進み具合が出るのでわかりやすい</li>
          <li>エラーが出ても飛ばして続ける</li>
          <li>連番でファイル名を整理できる</li>
          <li>Windows / Mac / Linux どこでも動く</li>
        </ul>
      </div>

      <h2>注意</h2>
      <ul>
        <li>画像を一気に大量にダウンロードすると、Twitter側のレート制限に引っかかるかもしれない</li>
        <li>他人の画像をダウンロードするときは著作権に注意</li>
        <li>ブラウザによっては自動ダウンロードをブロックされることもある</li>
        <li>Twitterの仕様が変わったら、スクリプトは動かなくなるかも</li>
      </ul>

      <h2>関連記事</h2>
      <ul>
        <li><a href="/tips/twitter-image-original-quality/">X(Twitter)の画像をオリジナル画質で保存する方法</a></li>
        <li><a href="/tips/twitter-image-only-filter/">X(Twitter)のタイムラインを「画像のみ」表示に切り替える</a></li>
      </ul>
    </article>

    <ArticleFooterNav currentHref="/tips/twitter-media-url-extractor/" currentTags={currentTags} backHref="/tips/" backLabel="← Tips一覧に戻る" />
</ArticleLayout>

