  }

  .article-body strong {
    font-weight: 600;
    color: var(--color-text);
  }

  pre {
    background: var(--color-codeblock-bg);
    color: var(--color-codeblock-text);
    padding: 1rem 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1rem 0;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  pre code {
    background: none;
    color: inherit;
    padding: 0;
  }

  .faq-list dt {
    font-weight: 600;
    margin-top: 1rem;
    margin-bottom: 0.25rem;
    color: var(--color-text);
  }
  .faq-list dd {
    margin-left: 0;
